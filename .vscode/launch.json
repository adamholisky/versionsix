{
    "configurations": [
    {
        "name": "Attach to QEMU",
        "type": "cppdbg",
        "request": "launch",
        "miDebuggerServerAddress": "plato.marsdev.io:58001",
        "cwd": "${workspaceFolder}",
        "program": "${workspaceFolder}/build/versionvi.bin",
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    }
    ]
}